{
  "name": "replay",
  "version": "0.1.0",
  "description": "Flight recorder + time-travel debugger for on-chain AI agents on Mantle",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "contract:test": "forge test",
    "deploy:flight-recorder": "scripts/deploy-flight-recorder.sh",
    "demo:toy": "tsx examples/toy-agent.ts",
    "smoke:evm": "tsx scripts/live-evm-smoke.ts",
    "smoke:meridian": "tsx scripts/meridian-replay-smoke.ts",
    "smoke:gaslight": "tsx scripts/gaslight-replay-smoke.ts",
    "preview:web": "vite preview --host 127.0.0.1",
    "kms:derive-address": "tsx scripts/derive-kms-address.ts",
    "build:demo-data": "tsx scripts/build-demo-data.ts",
    "build:pages": "npm run build:demo-data && vite build --base=/replay/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.17.0",
    "minimist": "^1.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}