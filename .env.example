# Anchor signer mode: "private-key" (default) or "tencent-kms".
REPLAY_SIGNER_MODE=private-key
# Required only for REPLAY_SIGNER_MODE=tencent-kms live signing.
TENCENT_KMS_KEY_ID=
TENCENT_KMS_REGION=ap-guangzhou
TENCENT_KMS_ADDRESS=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Frontend deploys use this at build time. Local dev defaults to http://localhost:4174.
VITE_REPLAY_API_BASE_URL=
